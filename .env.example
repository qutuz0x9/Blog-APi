# Template. Copy to .env.staging or .env.prod and fill in real values.
# Never commit the filled-in copies (.gitignore only allows .env.example and .env.dev).
# Generate a password with: openssl rand -hex 24

IMAGE_TAG=1.0.0
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=blog
LOG_LEVEL=info

# dev only: pgAdmin login
# PGADMIN_DEFAULT_EMAIL=admin@example.com
# PGADMIN_DEFAULT_PASSWORD=admin
