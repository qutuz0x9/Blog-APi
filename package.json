    "migration:status": "prisma migration status",
    "migration:list": "prisma migration list",
    "migration:log": "prisma migration log",
    "migration:graph": "prisma migration graph",
    "migration:check": "prisma migration check",
    "migration:show": "prisma migration show",
    "migration:ref:list": "prisma migration ref list",
    "migration:ref:set": "prisma migration ref set",
    "postinstall": "prisma skills sync || exit 0"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.13",
    "dotenv": "^18.0.5",
