{
  "name": "revision_docker",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "contract:emit": "prisma contract emit",
    "contract:format": "prisma contract format",
    "contract:print": "prisma contract print",
